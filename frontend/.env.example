# Copy to .env.local and never commit the copy.
# Only NEXT_PUBLIC_* values reach the browser, and none may contain secrets.

# API base used by the browser and by Server Components.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Set to "enabled" to run against the MSW mock API (`pnpm dev:mock` sets this).
# Never enable it in a production build.
NEXT_PUBLIC_API_MOCKING=disabled

# Server-only: directory holding local backend images served by /api/assets.
# Leave empty when assets are hosted (Cloudinary) URLs.
BACKEND_ASSET_DIR=

# Playwright "real" project API base; the project is skipped when unset.
E2E_API_URL=

# Override for `pnpm check:contract`.
CHECK_API_URL=

# Copy to .env for docker compose. Never commit .env.
POSTGRES_USER=marketpilot
POSTGRES_PASSWORD=marketpilot
POSTGRES_DB=marketpilot

# Backend settings (backend/.env) — placeholders only
DEEPSEEK_API_KEY=
DATABASE_URL=postgresql+asyncpg://marketpilot:marketpilot@localhost:5432/marketpilot
REDIS_URL=redis://localhost:6379/0
IMAGE_PROVIDER=fake
SEARCH_PROVIDER=fake
ASSET_DIR=assets
EMBEDDER=fake
SCORE_THRESHOLD=70
MAX_AUTO_LOOPS=2

# Frontend settings (frontend/.env.local) — placeholders only
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_MOCKING=disabled

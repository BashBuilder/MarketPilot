# Copy to backend/.env and fill in the required values. Never commit .env.
# APP_MODE=fake runs the full pipeline with scripted LLM outputs, fake images,
# fake search and fake embeddings: no network calls and no token spend.
APP_MODE=real

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

DATABASE_URL=postgresql+asyncpg://marketpilot:marketpilot@localhost:5432/marketpilot
REDIS_URL=redis://localhost:6379/0

IMAGE_PROVIDER=fake
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL_ID=stabilityai/sdxl-turbo
IMAGE_TIMEOUT_SECONDS=45
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_EDIT_MODEL=@cf/runwayml/stable-diffusion-v1-5-img2img

SEARCH_PROVIDER=fake
EMBEDDER=fake
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACEHUB_API_TOKEN=

ASSET_DIR=assets
ASSET_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=marketpilot
CLOUDINARY_TIMEOUT_SECONDS=30

COST_CAP_PER_RUN=2.0
MAX_IMAGE_CALLS_PER_RUN=8
MAX_GENERATED_IMAGES_PER_RUN=2
MAX_SEARCH_CALLS_PER_RUN=20
MAX_IMAGE_PROMPT_LENGTH=1000
RETRY_MAX_ATTEMPTS=3
SCORE_THRESHOLD=70
MAX_AUTO_LOOPS=2
MAX_IDEA_LENGTH=2000
MAX_COMMENT_LENGTH=2000

EVENT_STREAM_MAXLEN=2000
EVENT_STREAM_TTL_SECONDS=86400
SSE_HEARTBEAT_SECONDS=15
SSE_POLL_SECONDS=0.1
RESUME_ON_STARTUP=true

RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_RUNS=3
TRUST_PROXY=false
FRONTEND_ORIGIN=http://localhost:3000,https://marketpilot-demo-frontend.vercel.app
LOG_LEVEL=INFO
